<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Visibility of launchable apps, so the sync button can open the
         (user-configurable) WaterH app by package name. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- The server is reached over plain HTTP through the WireGuard tunnel
         (LAN IP), so cleartext must be allowed. The tunnel provides the
         transport encryption. -->
    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher_drop"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Glanceable dashboard, sized for cover/external displays too. -->
        <activity
            android:name=".DashboardActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ConfigActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SyncActivity"
            android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true"
            android:exported="false" />

        <!-- Exported for maximum compatibility with OEM cover-display widget
             hosts; onReceive only honors our own refresh/sync/add actions. -->
        <receiver
            android:name=".WaterWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/water_widget_info" />
        </receiver>
    </application>
</manifest>
