<?xml version="1.0" encoding="utf-8"?>
<!-- Compact variant: must fit a 1-cell-high widget, so every dp is rationed. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/txt_main"
        android:ellipsize="end"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text"
            android:maxLines="1"
            android:text="@string/main_placeholder" />

        <ImageButton
            android:id="@+id/btn_black"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_coffee_black"
            android:scaleType="fitCenter"
            android:padding="2dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/coffee_black" />

        <ImageButton
            android:id="@+id/btn_white"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_coffee_white"
            android:scaleType="fitCenter"
            android:padding="2dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/coffee_white" />

        <ImageButton
            android:id="@+id/btn_capp"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_coffee_capp"
            android:scaleType="fitCenter"
            android:padding="2dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/coffee_capp" />

        <ImageButton
            android:id="@+id/btn_sync"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_sync"
            android:scaleType="fitCenter"
            android:padding="2dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/sync_now" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="3dp"
        android:progressDrawable="@drawable/progress_water"
        android:max="1"
        android:progress="0" />

    <TextView
        android:id="@+id/txt_sub"
        android:ellipsize="end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textSize="11sp"
        android:textColor="@color/widget_text_secondary"
        android:maxLines="1"
        android:text="@string/error_not_configured" />
</LinearLayout>
