<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/widget_bg">

    <ImageButton
        android:id="@+id/btn_settings"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:src="@drawable/ic_settings"
        android:scaleType="fitCenter"
        android:padding="8dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/open_settings" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="24dp"
        android:paddingRight="24dp">

        <TextView
            android:id="@+id/txt_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text"
            android:maxLines="1"
            android:text="@string/main_placeholder" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="14dp"
            android:progressDrawable="@drawable/progress_water"
            android:max="1"
            android:progress="0" />

        <ProgressBar
            android:id="@+id/progress_coffee"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="9dp"
            android:layout_marginTop="6dp"
            android:visibility="gone"
            android:progressDrawable="@drawable/progress_coffee"
            android:max="1"
            android:progress="0" />

        <TextView
            android:id="@+id/txt_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="15sp"
            android:textColor="@color/widget_text_secondary"
            android:maxLines="2"
            android:gravity="center"
            android:text="@string/error_not_configured" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btn_black"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_coffee_black"
                android:scaleType="fitCenter"
                android:padding="6dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/coffee_black" />

            <ImageButton
                android:id="@+id/btn_white"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:src="@drawable/ic_coffee_white"
                android:scaleType="fitCenter"
                android:padding="6dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/coffee_white" />

            <ImageButton
                android:id="@+id/btn_capp"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:src="@drawable/ic_coffee_capp"
                android:scaleType="fitCenter"
                android:padding="6dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/coffee_capp" />

            <ImageButton
                android:id="@+id/btn_undo"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:visibility="gone"
                android:src="@drawable/ic_undo"
                android:scaleType="fitCenter"
                android:padding="9dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/undo_last" />

            <ImageButton
                android:id="@+id/btn_sync"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="14dp"
                android:src="@drawable/ic_sync"
                android:scaleType="fitCenter"
                android:padding="6dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/sync_now" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
