<?xml version="1.0" encoding="utf-8"?>
<!-- Large variant: 2+ cells high — full-width title, water bar plus a brown
     coffee-share bar on the same scale, and a roomy button row at the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingLeft="18dp"
    android:paddingRight="18dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:id="@+id/txt_main"
        android:ellipsize="end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/widget_text"
        android:maxLines="1"
        android:text="@string/main_placeholder" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:layout_marginTop="10dp"
        android:progressDrawable="@drawable/progress_water"
        android:max="1"
        android:progress="0" />

    <ProgressBar
        android:id="@+id/progress_coffee"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="5dp"
        android:visibility="gone"
        android:progressDrawable="@drawable/progress_coffee"
        android:max="1"
        android:progress="0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/txt_sub"
            android:ellipsize="end"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="15sp"
            android:textColor="@color/widget_text_secondary"
            android:maxLines="1"
            android:text="@string/error_not_configured" />

        <ImageButton
            android:id="@+id/btn_black"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:src="@drawable/ic_coffee_black"
            android:scaleType="fitCenter"
            android:padding="4dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/coffee_black" />

        <ImageButton
            android:id="@+id/btn_white"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:src="@drawable/ic_coffee_white"
            android:scaleType="fitCenter"
            android:padding="4dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/coffee_white" />

        <ImageButton
            android:id="@+id/btn_capp"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:src="@drawable/ic_coffee_capp"
            android:scaleType="fitCenter"
            android:padding="4dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/coffee_capp" />

        <ImageButton
            android:id="@+id/btn_undo"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:visibility="gone"
            android:src="@drawable/ic_undo"
            android:scaleType="fitCenter"
            android:padding="6dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/undo_last" />

        <ImageButton
            android:id="@+id/btn_sync"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:src="@drawable/ic_sync"
            android:scaleType="fitCenter"
            android:padding="4dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/sync_now" />
    </LinearLayout>
</LinearLayout>
